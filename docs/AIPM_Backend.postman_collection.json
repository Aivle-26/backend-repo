          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const docs = pm.response.json().documents || [];",
                  "  if (docs.length) pm.collectionVariables.set('documentId', docs[0].documentId);",
                  "}"
