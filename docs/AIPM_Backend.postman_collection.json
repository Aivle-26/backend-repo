              "raw": "{\n  \"name\": \"쇼핑몰 고도화 프로젝트\",\n  \"description\": \"주문·결제·배송 기능을 개선한다.\",\n  \"pmEmployeeNumber\": \"PM-0001\",\n  \"plannedStartDate\": \"2026-08-03\",\n  \"plannedEndDate\": \"2026-10-30\"\n}"
            },
            "url": "{{baseUrl}}/api/projects/drafts"
          }
        },
