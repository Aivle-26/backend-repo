        },
        {
          "name": "03 문서 목록 및 documentId 저장",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const docs = pm.response.json().documents || [];",
                  "pm.test('업로드 문서 존재', () => pm.expect(docs.length).to.be.above(0));",
