DB_URL=jdbc:mysql://127.0.0.1:3306/aipm
DB_USERNAME=aipm_user
DB_PASSWORD=change_me
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
CORS_ALLOW_CREDENTIALS=false

# 운영용 AWS SES SMTP
# SES 콘솔에서 발급한 SMTP 전용 자격증명을 사용한다. 실제 값은 Git에 커밋하지 않는다.
MAIL_ENABLED=true
MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=SES_SMTP_USERNAME
MAIL_PASSWORD=SES_SMTP_PASSWORD
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM_ADDRESS=no-reply@your-service-domain.example
MAIL_FROM_NAME=BidWorks AI
MAIL_REPLY_TO=support@your-service-domain.example
MAIL_SUBJECT_PREFIX=[BidWorks AI]
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_DELAY_MS=500

# AWS S3 문서 저장
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-project-document-bucket

# 프로젝트 문서 분석 서버
PLANNING_AGENT_BASE_URL=http://localhost:8000
PLANNING_AGENT_EXTRACT_PATH=/api/v1/planning/documents/extract
PLANNING_AGENT_WBS_PATH=/api/v1/planning/wbs/generate

# Slack 연동 (실제 토큰은 절대 커밋하지 말 것)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_FETCH_LIMIT=200

# AI 서버 (FastAPI)
AI_SERVER_BASE_URL=http://localhost:8000
AI_SERVER_TIMEOUT_SECONDS=60
AI_SERVER_ENABLE_LLM=true
