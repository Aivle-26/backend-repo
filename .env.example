DB_URL=jdbc:mysql://127.0.0.1:3306/aipm
DB_USERNAME=aipm_user
DB_PASSWORD=change_me
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
CORS_ALLOW_CREDENTIALS=false

# AWS S3 문서 저장
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-project-document-bucket

# 프로젝트 문서 분석 서버
PLANNING_AGENT_BASE_URL=http://localhost:8000
PLANNING_AGENT_EXTRACT_PATH=/api/v1/planning/documents/extract

# Slack 연동 (실제 토큰은 절대 커밋하지 말 것)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_FETCH_LIMIT=200

# AI 서버 (FastAPI)
AI_SERVER_BASE_URL=http://localhost:8000
AI_SERVER_TIMEOUT_SECONDS=60
AI_SERVER_ENABLE_LLM=true
