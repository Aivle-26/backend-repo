# PMate Backend environment template
#
# Copy this file to a local, untracked environment file and replace every
# placeholder before starting the application. Never commit real credentials.

# Spring profile, server, CORS, and upload limits
SPRING_PROFILES_ACTIVE=replace-with-spring-profile
SERVER_ADDRESS=replace-with-server-bind-address
SERVER_PORT=replace-with-server-port
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CORS_ALLOW_CREDENTIALS=replace-with-true-or-false
SPRING_MULTIPART_MAX_FILE_SIZE=replace-with-file-size-limit
SPRING_MULTIPART_MAX_REQUEST_SIZE=replace-with-request-size-limit

# Database and JPA
DB_URL=jdbc:mysql://your-database-host:3306/your-database-name
DB_USERNAME=your-database-username
DB_PASSWORD=replace-with-database-password
JPA_DDL_AUTO=replace-with-jpa-ddl-mode
JPA_SHOW_SQL=replace-with-true-or-false
JPA_FORMAT_SQL=replace-with-true-or-false

# Authentication
AUTH_JWT_SECRET=replace-with-a-long-random-jwt-secret
AUTH_ACCESS_TOKEN_EXPIRATION_MINUTES=replace-with-access-token-expiration-minutes
AUTH_ABSOLUTE_LOGIN_EXPIRATION_HOURS=replace-with-absolute-login-expiration-hours

# Document storage and Amazon S3
DOCUMENT_STORAGE_TYPE=replace-with-local-or-s3
DOCUMENT_STORAGE_PATH=replace-with-local-document-storage-path
DOCUMENT_MAX_FILE_SIZE=replace-with-document-file-size-limit
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket

# Optional: DefaultCredentialsProvider reads these when instance-role
# credentials are unavailable. Prefer an IAM role on EC2.
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
# AWS_SESSION_TOKEN=replace-with-aws-session-token

# AI server
AI_SERVER_BASE_URL=http://your-ai-server-host:8000
AI_SERVER_TIMEOUT_SECONDS=replace-with-ai-server-timeout-seconds
AI_SERVER_CONNECT_TIMEOUT_SECONDS=replace-with-ai-server-connect-timeout-seconds
AI_SERVER_RESPONSE_TIMEOUT_SECONDS=replace-with-ai-server-response-timeout-seconds
AI_SERVER_DOCUMENT_EXTRACT_PATH=/replace-with-document-extract-path
AI_SERVER_ENABLE_LLM=replace-with-true-or-false

# Planning agent
PLANNING_AGENT_BASE_URL=http://your-planning-agent-host:8000
PLANNING_AGENT_CONNECT_TIMEOUT=replace-with-planning-agent-connect-timeout
PLANNING_AGENT_READ_TIMEOUT=replace-with-planning-agent-read-timeout
PLANNING_AGENT_EXTRACT_PATH=/replace-with-planning-extract-path
PLANNING_AGENT_READJUST_PATH=/replace-with-planning-readjust-path
PLANNING_AGENT_WBS_PATH=/replace-with-planning-wbs-path
PLANNING_AGENT_SCHEDULE_PATH=/replace-with-planning-schedule-path
PLANNING_AGENT_RESOURCE_PATH=/replace-with-planning-resource-path
PLANNING_AGENT_ORGANIZATION_CHART_PATH=/replace-with-organization-chart-path
PLANNING_AGENT_ORGANIZATION_CHART_RENDER_PATH=/replace-with-organization-chart-render-path
PLANNING_AGENT_UI_MOCKUP_PATH=/replace-with-ui-mockup-path
PLANNING_AGENT_COST_PATH=/replace-with-planning-cost-path
PLANNING_AGENT_RAG_QUERY_PATH=/replace-with-rag-query-path
PLANNING_AGENT_WEEKLY_SCRUM_SUMMARIZE_PATH=/replace-with-weekly-scrum-summarize-path
PLANNING_AGENT_WEEKLY_SCRUM_REVIEW_PATH=/replace-with-weekly-scrum-review-path
PLANNING_AGENT_WEEKLY_SCRUM_RECOMMEND_PATH=/replace-with-weekly-scrum-recommend-path
PLANNING_AGENT_WEEKLY_SCRUM_FINALIZE_PATH=/replace-with-weekly-scrum-finalize-path
PLANNING_AGENT_SCHEDULE_VERSION=replace-with-planning-schedule-version

# Slack integration
SLACK_BOT_TOKEN=replace-with-slack-bot-token
SLACK_FETCH_LIMIT=replace-with-slack-fetch-limit

# Mail delivery
MAIL_ENABLED=replace-with-true-or-false
MAIL_HOST=your-mail-host
MAIL_PORT=replace-with-mail-port
MAIL_USERNAME=your-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_SMTP_AUTH=replace-with-true-or-false
MAIL_STARTTLS_ENABLE=replace-with-true-or-false
MAIL_STARTTLS_REQUIRED=replace-with-true-or-false
MAIL_CONNECTION_TIMEOUT=replace-with-mail-connection-timeout
MAIL_TIMEOUT=replace-with-mail-timeout
MAIL_WRITE_TIMEOUT=replace-with-mail-write-timeout
MAIL_FROM_ADDRESS=your-sender@example.com
MAIL_FROM_NAME=your-mail-from-name
MAIL_REPLY_TO=your-reply-to@example.com
MAIL_SUBJECT_PREFIX=your-mail-subject-prefix
MAIL_MAX_ATTEMPTS=replace-with-mail-max-attempts
MAIL_RETRY_DELAY_MS=replace-with-mail-retry-delay-ms
MAIL_BACKGROUND_IMAGE_URL=https://your-assets.example.com/mail-background.png
